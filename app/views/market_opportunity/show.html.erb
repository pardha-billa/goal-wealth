<% inputs = @analysis[:inputs] %>
<% segments = @analysis[:segments] %>
<% ranked_segments = @analysis[:ranked_segments] %>
<% overall = @analysis[:overall] %>
<% checklist = @analysis[:checklist] %>
<% deployment = @analysis[:deployment] %>

<div class="content">
  <div class="card mb-3">
    <div class="card-body">
      <div class="d-flex flex-wrap align-items-center justify-content-between gap-3">
        <div>
          <div class="d-flex flex-wrap gap-2 mb-2">
            <span class="badge bg-primary-subtle text-primary">Market Opportunity</span>
            <span class="badge bg-info-subtle text-info"><%= overall[:condition_label] %></span>
            <span class="badge bg-light text-700">Source: <%= inputs[:source_as_of].presence || "Unavailable" %></span>
          </div>
          <h2 class="mb-1">Market Opportunity</h2>
          <p class="text-500 mb-0">Market allocation and lumpsum readiness across Nifty 50, Nifty Next 50, large cap, mid cap and small cap segments. Large cap here is the broad large-cap bucket derived from Nifty 50 and Nifty Next 50.</p>
        </div>
        <div class="text-lg-end">
          <div class="fs-10 text-500">Composite segment score</div>
          <div class="fs-3 fw-semibold"><%= overall[:score].present? ? "#{number_with_precision(overall[:score], precision: 1, strip_insignificant_zeros: true)}/100" : "Unavailable" %></div>
        </div>
      </div>
      <div class="mt-4">
        <div class="fs-4 fw-semibold mb-1"><%= overall[:headline] %></div>
        <p class="mb-0 text-700"><%= overall[:overall_summary] %></p>
        <p class="mb-0 mt-2 fs-11 text-500"><%= overall[:data_source_note] %></p>
      </div>
    </div>
  </div>

  <div class="card mb-3">
    <div class="card-header py-3">
      <h6 class="mb-0">Source data</h6>
    </div>
    <div class="card-body">
      <p class="text-500 mb-3">This page is read-only on market data. Values come from official NSE factsheets; anything not sourced is shown as unavailable.</p>
      <div class="row g-3">
        <% (inputs[:source_segments] || {}).each do |key, segment| %>
          <div class="col-md-6 col-xl-3">
            <div class="border rounded-2 p-3 h-100">
              <div class="fw-semibold mb-1"><%= segment[:label] %></div>
              <div class="fs-11 text-500 mb-2"><%= segment[:source_url] %></div>
              <div class="fs-11 text-500">As of <%= segment[:as_of].presence || "Unavailable" %></div>
            </div>
          </div>
        <% end %>
      </div>
    </div>
  </div>

  <div class="card mb-3">
    <div class="card-header py-3">
      <h6 class="mb-0">A. Overall market condition</h6>
    </div>
    <div class="card-body">
      <div class="row g-3">
        <div class="col-lg-7">
          <p class="text-700 mb-3"><%= overall[:where_attractive_now] %></p>
          <div class="row g-3">
            <% [
              ["Valuation percentile", overall[:valuation_percentile]],
              ["Earnings growth", overall[:earnings_growth]],
              ["Momentum score", overall[:momentum_score]],
              ["Top segment", overall[:top_segment]]
            ].each do |label, value| %>
              <div class="col-sm-6 col-xl-3">
                <div class="border rounded-2 p-3 h-100">
                  <div class="fs-11 text-500 text-uppercase mb-1"><%= label %></div>
                  <div class="fw-semibold"><%= value.is_a?(Numeric) ? number_with_precision(value, precision: 1, strip_insignificant_zeros: true) : value %></div>
                </div>
              </div>
            <% end %>
          </div>
        </div>
        <div class="col-lg-5">
          <div class="border rounded-2 p-3 h-100">
            <div class="fs-11 text-500 text-uppercase mb-2">Market bias</div>
            <div class="fs-5 fw-semibold mb-2"><%= overall[:market_bias] %></div>
            <p class="mb-0 text-700"><%= overall[:deployment_note] %></p>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="card mb-3">
    <div class="card-header py-3">
      <h6 class="mb-0">B. Segment comparison</h6>
    </div>
    <div class="card-body p-0">
      <div class="table-responsive">
        <table class="table table-hover mb-0 align-middle">
          <thead class="bg-100">
            <tr>
              <th>Segment</th>
              <th>Valuation</th>
              <th>Earnings</th>
              <th>Risk</th>
              <th>Lumpsum view</th>
              <th class="text-end">Opportunity score</th>
            </tr>
          </thead>
          <tbody>
            <% ranked_segments.each do |segment| %>
              <tr>
                <td>
                  <div class="fw-semibold"><%= segment[:label] %></div>
                  <div class="fs-11 text-500"><%= segment[:commentary] %></div>
                </td>
                <td><span class="badge bg-100 text-700"><%= segment[:valuation_label] %></span></td>
                <td><span class="badge bg-100 text-700"><%= segment[:earnings_label] %></span></td>
                <td><span class="badge bg-100 text-700"><%= segment[:risk_label] %></span></td>
                <td><span class="badge bg-primary-subtle text-primary"><%= segment[:lumpsum_view] %></span></td>
                <td class="text-end fw-semibold"><%= segment[:score].present? ? "#{number_with_precision(segment[:score], precision: 1, strip_insignificant_zeros: true)}/100" : "Unavailable" %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>
  </div>

  <div class="card mb-3">
    <div class="card-header py-3">
      <h6 class="mb-0">C. Where is relatively attractive now?</h6>
    </div>
    <div class="card-body">
      <p class="mb-3"><strong>Most favourable:</strong> <%= ranked_segments[0][:label] %></p>
      <p class="mb-3"><strong>Moderately favourable:</strong> <%= ranked_segments[1][:label] %></p>
      <p class="mb-3"><strong>Selective:</strong> <%= ranked_segments[2][:label] %></p>
      <p class="mb-0"><strong>Unfavourable for fresh lumpsum:</strong> <%= ranked_segments[-1][:label] %></p>
    </div>
  </div>

  <div class="card mb-3">
    <div class="card-header py-3">
      <h6 class="mb-0">D. Lumpsum investor checklist</h6>
    </div>
    <div class="card-body">
      <div class="row g-3">
        <% checklist.each do |item| %>
          <% badge_class = item[:status] == :pass ? "bg-success-subtle text-success" : "bg-warning-subtle text-warning" %>
          <div class="col-md-6">
            <div class="border rounded-2 p-3 h-100">
              <div class="d-flex align-items-start justify-content-between gap-2">
                <div>
              <div class="fw-semibold"><%= item[:label] %></div>
              <div class="fs-11 text-500"><%= item[:note] %></div>
                </div>
                <span class="badge <%= badge_class %>"><%= item[:status] == :pass ? "Pass" : "Watch" %></span>
              </div>
              <div class="mt-2 text-700"><%= item[:value] %></div>
            </div>
          </div>
        <% end %>
      </div>
    </div>
  </div>

  <div class="card mb-4">
    <div class="card-header py-3">
      <h6 class="mb-0">E. Suggested deployment method</h6>
    </div>
    <div class="card-body">
      <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-3">
        <div>
          <div class="fs-5 fw-semibold"><%= deployment[:method] %></div>
          <p class="mb-0 text-700"><%= deployment[:rationale] %></p>
        </div>
      </div>
      <div class="row g-3">
        <% deployment[:schedule].each do |step| %>
          <div class="col-sm-6 col-lg-3">
            <div class="border rounded-2 p-3 h-100">
              <div class="fs-11 text-500 text-uppercase mb-1"><%= step[:label] %></div>
              <div class="fs-4 fw-semibold"><%= step[:percent] %>%</div>
            </div>
          </div>
        <% end %>
      </div>
      <div class="alert alert-light border mt-4 mb-0">
        Based on current valuation, earnings and risk indicators, <strong><%= ranked_segments[0][:label] %></strong> currently offers the better risk reward profile, but deployment should still follow the readiness checklist.
      </div>
    </div>
  </div>
</div>
