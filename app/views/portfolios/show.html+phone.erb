<% return_pct = @summary.return_pct %>
<% xirr_pct = @summary.xirr_pct %>
<% target_progress = @summary.target_progress_pct %>
<% target_progress_width = target_progress ? [[target_progress, 0].max, 100].min : 0 %>
<% remaining_to_target = @summary.remaining_to_target %>
<% largest_holding = @summary.largest_holding %>
<% best_holding = @summary.best_holding %>
<% weakest_holding = @summary.weakest_holding %>
<% concentration_pct = largest_holding&.dig(:allocation_pct) %>
<% days_to_target = @goal.target_date ? (@goal.target_date - Date.current).to_i : nil %>
<% transaction_rows = @summary.recent_transactions(8) %>

<div class="mobile-page">
  <section class="mobile-hero">
    <div class="d-flex flex-wrap align-items-center gap-2 mb-2">
      <span class="badge bg-primary-subtle text-primary"><%= @goal.code %></span>
      <span class="badge bg-success-subtle text-success"><%= @goal.status.humanize %></span>
      <% if @goal.target_date.present? %>
        <span class="badge bg-info-subtle text-info"><%= @goal.target_date.strftime('%d/%m/%Y') %></span>
      <% end %>
    </div>
    <h2 class="mobile-title"><%= @goal.name %></h2>
    <p class="mobile-subtitle"><%= @goal.description.presence || 'Portfolio performance and allocation summary.' %></p>

    <div class="mobile-actions mt-3">
      <%= link_to '<span class="fas fa-arrow-left me-1"></span>Back to Home'.html_safe, root_path, class: 'btn btn-sm btn-falcon-default' %>
    </div>
  </section>

  <section class="mobile-card">
    <div class="mobile-card-body">
      <div class="mobile-kpi-grid">
        <div class="mobile-kpi">
          <div class="mobile-kpi-label">Current</div>
          <div class="mobile-kpi-value"><%= indian_currency(@summary.current_value) %></div>
        </div>
        <div class="mobile-kpi">
          <div class="mobile-kpi-label">Invested</div>
          <div class="mobile-kpi-value"><%= indian_currency(@summary.total_invested) %></div>
        </div>
        <div class="mobile-kpi">
          <div class="mobile-kpi-label">Gain/Loss</div>
          <div class="mobile-kpi-value text-<%= portfolio_trend_class(@summary.absolute_return) %>"><%= indian_currency(@summary.absolute_return) %></div>
        </div>
        <div class="mobile-kpi">
          <div class="mobile-kpi-label">XIRR</div>
          <div class="mobile-kpi-value text-<%= portfolio_trend_class(xirr_pct) %>"><%= portfolio_percent(xirr_pct) %></div>
        </div>
      </div>

      <% if @goal.target_amount.present? %>
        <div class="mt-3">
          <div class="d-flex justify-content-between align-items-center mb-2">
            <span class="fs-10 text-600">Goal progress</span>
            <span class="fs-10 fw-semibold"><%= portfolio_percent(target_progress) %></span>
          </div>
          <div class="progress bg-100 mobile-progress">
            <div class="progress-bar bg-primary" role="progressbar" style="width: <%= target_progress_width %>%;"></div>
          </div>
          <div class="mobile-meta">
            <%= remaining_to_target && remaining_to_target.positive? ? "#{compact_indian_currency(remaining_to_target)} remaining" : 'Target funded' %>
            <% if days_to_target %>
              | <%= days_to_target.positive? ? "#{days_to_target} days left" : "#{days_to_target.abs} days past target" %>
            <% end %>
          </div>
        </div>
      <% end %>
    </div>
  </section>

  <section class="mobile-card">
    <div class="mobile-section-title">Decision Snapshot</div>
    <div class="mobile-card-body">
      <div class="mobile-kpi-grid">
        <div class="mobile-kpi">
          <div class="mobile-kpi-label">Best</div>
          <div class="mobile-kpi-value"><%= best_holding ? best_holding[:asset].name.truncate(18) : 'NA' %></div>
          <div class="mobile-meta text-<%= portfolio_trend_class(best_holding&.dig(:return_pct)) %>"><%= best_holding ? portfolio_percent(best_holding[:return_pct]) : 'No data' %></div>
        </div>
        <div class="mobile-kpi">
          <div class="mobile-kpi-label">Watch</div>
          <div class="mobile-kpi-value"><%= weakest_holding ? weakest_holding[:asset].name.truncate(18) : 'NA' %></div>
          <div class="mobile-meta text-<%= portfolio_trend_class(weakest_holding&.dig(:return_pct)) %>"><%= weakest_holding ? portfolio_percent(weakest_holding[:return_pct]) : 'No data' %></div>
        </div>
        <div class="mobile-kpi">
          <div class="mobile-kpi-label">Largest</div>
          <div class="mobile-kpi-value"><%= largest_holding ? largest_holding[:asset].name.truncate(18) : 'NA' %></div>
          <div class="mobile-meta"><%= concentration_pct ? portfolio_percent(concentration_pct) : 'No holdings' %></div>
        </div>
        <div class="mobile-kpi">
          <div class="mobile-kpi-label">Return</div>
          <div class="mobile-kpi-value text-<%= portfolio_trend_class(return_pct) %>"><%= portfolio_percent(return_pct) %></div>
          <div class="mobile-meta"><%= @summary.asset_count %> holdings</div>
        </div>
      </div>
    </div>
  </section>

  <section class="mobile-card">
    <div class="mobile-section-title">Top Holdings</div>
    <div class="mobile-list">
      <% @summary.top_holdings.first(8).each do |holding| %>
        <div class="mobile-list-item">
          <div class="mobile-row">
            <div class="mobile-row-main">
              <div class="mobile-list-title"><%= holding[:asset].name %></div>
              <div class="mobile-meta"><%= portfolio_percent(holding[:allocation_pct]) %> allocation</div>
            </div>
            <div class="mobile-row-value">
              <div class="fw-semibold"><%= compact_indian_currency(holding[:market_value]) %></div>
            </div>
          </div>
        </div>
      <% end %>
      <% unless @summary.top_holdings.any? %>
        <div class="mobile-list-item text-500 fs-10">No holdings available.</div>
      <% end %>
    </div>
  </section>

  <section class="mobile-card">
    <div class="mobile-section-title">Category Mix</div>
    <div class="mobile-card-body">
      <% if @summary.category_breakdown.any? %>
        <% @summary.category_breakdown.each do |row| %>
          <div class="mb-3">
            <div class="d-flex justify-content-between align-items-center mb-2">
              <span class="fs-10 text-600"><%= row[:asset_category].humanize %></span>
              <span class="fs-10 fw-semibold"><%= portfolio_percent(row[:percentage]) %></span>
            </div>
            <div class="progress bg-100 mobile-progress">
              <div class="progress-bar bg-primary" role="progressbar" style="width: <%= row[:percentage] || 0 %>%;"></div>
            </div>
            <div class="mobile-meta"><%= compact_indian_currency(row[:value]) %></div>
          </div>
        <% end %>
      <% else %>
        <p class="fs-10 text-500 mb-0">No allocation data available.</p>
      <% end %>
    </div>
  </section>

  <section class="mobile-card">
    <div class="mobile-section-title">Recent Transactions</div>
    <div class="mobile-list">
      <% transaction_rows.each do |tx| %>
        <div class="mobile-list-item">
          <div class="mobile-row">
            <div class="mobile-row-main">
              <div class="mobile-list-title"><%= tx.asset.name %></div>
              <div class="mobile-meta"><%= tx.transaction_date.strftime('%d/%m/%Y') %> | <%= tx.transaction_type.humanize %></div>
            </div>
            <div class="mobile-row-value">
              <div class="fw-semibold"><%= compact_indian_currency(tx.amount) %></div>
            </div>
          </div>
        </div>
      <% end %>
      <% unless transaction_rows.any? %>
        <div class="mobile-list-item text-500 fs-10">No recent transactions.</div>
      <% end %>
    </div>
  </section>
</div>
